# Vite 在建置時讀取；網址 ?service=mock 或 ?service=api 可明確覆寫。
VITE_SERVICE_MODE=api

# Docker Compose 會讀取根目錄 .env；本機 Python 不會自動載入此檔。
# 本機預設使用專案根目錄 .local/cases.sqlite3。
# Compose 固定使用 /app/.local/cases.sqlite3，並掛載具名 volume。
CASE_DB_PATH=.local/cases.sqlite3
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5174,http://localhost:5174
RATE_LIMIT_REQUESTS=120
SESSION_COOKIE_SECURE=false

# 可選的短期 Demo URL 金鑰模式；未啟用時沿用原本 LLM_* 後端設定。
# 本節須顯式傳入Python程序環境；Cloudflare配置會注入，現有Compose未轉交這三個變數。
# 啟用後每次 health／對話請求從 X-OpenRouter-Key 取得金鑰，絕不回退 LLM_API_KEY。
# 固定官方 OpenRouter 與 deepseek/deepseek-v4.1-flash-1017、300 秒；不是模型選擇開關。
# 前端入口格式 https://<展示網域>/?key=<短期OpenRouter金鑰>；此處勿填真金鑰。
RUNTIME_LLM_KEYS=false

# 可選 Cloudflare HTTPCaseStore；兩項都不設定時使用 CASE_DB_PATH 的本機 SQLite。
# 任一項有值就選遠端，設定不完整會啟動失敗，不會靜默改回暫存磁碟。
# URL 僅接受自己的 HTTPS *.workers.dev/__internal/cases，無 query／fragment。
# CASE_STORE_TOKEN 為獨立內部憑證（建議至少 32 隨機 bytes），不是模型金鑰。
# Cloudflare 由 Worker secret 注入；不可放在 VITE_*、URL、Git 或映像。
# CASE_STORE_URL=https://<自己的worker>.<子網域>.workers.dev/__internal/cases
# CASE_STORE_TOKEN=

# 預設執行真實本機規則／官方資料檢索，不使用生成式 LLM或外部金鑰。
# 稍後如需外部模式，改為 openai_compatible，並在後端安全配置下列必填值。
# OpenRouter目前使用明確授權的DeepSeek模型，設定與實測見 docs/DEEPSEEK_SETUP.md。
# 此範本保持無憑證本機模式；設定存在不代表模型已驗證。
LLM_PROVIDER=grounded_rules
LLM_BASE_URL=https://api.openai.com/v1
# 以下兩項在 openai_compatible 模式必填；模型無預設，不要放入 VITE_ 變數。
LLM_API_KEY=
LLM_MODEL=
# OpenRouter僅允許 openrouter/free 或 deepseek/deepseek-v4.1-flash-1017。
# 預設模式的實際key只注入後端；可選 runtime 模式改用分頁暫存與必要請求標頭。
# 付費DeepSeek固定官方供應商，費用依後端profile驗證。
# 可選逾時：相容服務預設20秒、最多60秒；OpenRouter預設／最多300秒。
# 前端對話透過背景工作查詢結果，後端處理310秒、前端總等待330秒。
# LLM_TIMEOUT_SECONDS=300

# 三家供應商的後端憑證預留欄位；目前不讀取、不自動轉接至 LLM_API_KEY。
# OpenAI／Gemini仍暫緩；OpenRouter實際key只存受保護的本機後端設定。
# 以下範本保持空白；不可加上 VITE_ 前綴或提交真實金鑰。
# 此範本不表示金鑰已配置、驗證或已完成 Gemini／OpenRouter 串接。
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# 此預留名稱不自動啟用服務；實際啟動明確使用通用LLM_*欄位。
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017

# 僅供可選 Caddy HTTPS profile 使用。
# 對外環境需填自有網域、將 ALLOWED_ORIGINS 改為正確 HTTPS origin，
# 並將 SESSION_COOKIE_SECURE 設為 true；此範例不代表已部署。
DOMAIN=localhost
