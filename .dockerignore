!scripts/
!scripts/prepare-assets.mjs
!data/
!data/official-sources.json
!backend/
!backend/app/
!backend/app/**
!backend/requirements.txt
!backend/constraints.txt
**/__pycache__/
**/*.pyc
**/*.pyo
**/.env
**/.env.*
**/*.sqlite*
**/*.db
